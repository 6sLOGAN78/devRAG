# Rendered by scripts/render_conf.py into conf/service_conf.yaml (never committed).
# Variable forms: dash-default uses the default when unset or empty; question-mark form aborts when unset or empty.
ragflow:
  host: '${RAGFLOW_HOST:-0.0.0.0}'
  http_port: ${SVR_HTTP_PORT:-9380}
go_api:
  host: '${GO_API_HOST:-0.0.0.0}'
  http_port: ${GO_API_PORT:-9384}
mysql:
  name: '${MYSQL_DBNAME:-rag_flow}'
  user: '${MYSQL_USER:-ragflow_app}'
  password: '${MYSQL_PASSWORD:?MYSQL_PASSWORD is required (run make init-env)}'
  host: '${MYSQL_HOST:-mysql}'
  port: ${MYSQL_PORT:-3306}
  max_connections: ${MYSQL_MAX_CONNECTIONS:-100}
  stale_timeout: ${MYSQL_STALE_TIMEOUT:-300}
  read_timeout: ${MYSQL_READ_TIMEOUT:-30}
  write_timeout: ${MYSQL_WRITE_TIMEOUT:-30}
redis:
  host: '${REDIS_HOST:-redis}'
  port: ${REDIS_PORT:-6379}
  password: '${REDIS_PASSWORD:?REDIS_PASSWORD is required (run make init-env)}'
  db: ${REDIS_DB:-1}
minio:
  user: '${MINIO_USER:-rag_flow}'
  password: '${MINIO_PASSWORD:?MINIO_PASSWORD is required (run make init-env)}'
  host: '${MINIO_HOST:-minio}'
  port: ${MINIO_PORT:-9000}
es:
  hosts: 'http://${ES_HOST:-es01}:${ES_PORT:-9200}'
  username: '${ES_USER:-elastic}'
  password: '${ELASTIC_PASSWORD:?ELASTIC_PASSWORD is required (run make init-env)}'
# Empty allowed_origins means same-origin only (D-14).
cors:
  allowed_origins: '${CORS_ALLOWED_ORIGINS:-}'
logging:
  dir: '${LOG_DIR:-}'
  level: '${LOG_LEVEL:-INFO}'
security:
  secret_key: '${SECRET_KEY:?SECRET_KEY is required, at least 32 characters (run make init-env)}'
auth:
  register_enabled: '${REGISTER_ENABLED:-1}'
  superuser_email: '${SUPERUSER_EMAIL:-}'
  superuser_password: '${SUPERUSER_PASSWORD:-}'
  otp_ttl_seconds: ${OTP_TTL_SECONDS:-600}
mail:
  host: '${SMTP_HOST:-mailpit}'
  port: ${SMTP_PORT:-1025}
  security: '${SMTP_SECURITY:-none}'
  username: '${SMTP_USERNAME:-}'
  password: '${SMTP_PASSWORD:-}'
  from: '${SMTP_FROM:-no-reply@devrag.local}'
models:
  default_chat_model: '${DEFAULT_CHAT_MODEL:-}'
  default_embedding_model: '${DEFAULT_EMBEDDING_MODEL:-}'
  default_rerank_model: '${DEFAULT_RERANK_MODEL:-}'
  default_factory: '${DEFAULT_MODEL_FACTORY:-}'
  default_base_url: '${DEFAULT_MODEL_BASE_URL:-}'
# Defaults are the R-94 production numbers (D-29). Only docker-compose.dev.yml raises per-IP values.
ratelimit:
  register_per_ip: ${RATE_LIMIT_REGISTER_PER_IP:-10}
  register_window_seconds: ${RATE_LIMIT_REGISTER_WINDOW_SECONDS:-3600}
  login_failures_per_email: ${RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL:-5}
  login_per_ip: ${RATE_LIMIT_LOGIN_PER_IP:-30}
  login_window_seconds: ${RATE_LIMIT_LOGIN_WINDOW_SECONDS:-900}
  otp_email_interval_seconds: ${RATE_LIMIT_OTP_EMAIL_INTERVAL_SECONDS:-60}
  otp_per_email_per_hour: ${RATE_LIMIT_OTP_PER_EMAIL_PER_HOUR:-5}
  otp_per_ip_per_hour: ${RATE_LIMIT_OTP_PER_IP_PER_HOUR:-20}
  otp_window_seconds: ${RATE_LIMIT_OTP_WINDOW_SECONDS:-3600}
  provider_test_per_tenant: ${RATE_LIMIT_PROVIDER_TEST_PER_TENANT:-10}
  provider_test_window_seconds: ${RATE_LIMIT_PROVIDER_TEST_WINDOW_SECONDS:-300}
# Provider-key encryption and model-call limits (SEC-03, D-23). The key is URL-safe base64 of 32 random bytes.
llm:
  encryption_key: '${LLM_KEY_ENCRYPTION_KEY:-}'
  key_id: '${LLM_KEY_ID:-k1}'
  allow_private_base_urls: '${LLM_ALLOW_PRIVATE_BASE_URLS:-false}'
  chat_timeout_seconds: ${LLM_CHAT_TIMEOUT_SECONDS:-60}
  embedding_timeout_seconds: ${LLM_EMBEDDING_TIMEOUT_SECONDS:-30}
  key_test_timeout_seconds: ${LLM_KEY_TEST_TIMEOUT_SECONDS:-20}
  max_retries: ${LLM_MAX_RETRIES:-3}
storage:
  impl: '${STORAGE_IMPL:-MINIO}'
  local_base_dir: '${STORAGE_LOCAL_DIR:-/ragflow/data/storage}'
# Upload limits (D-11, D-13). max_file_bytes is capped at 104857600 so it can never exceed the Nginx body cap of 101m.
upload:
  max_file_bytes: ${UPLOAD_MAX_FILE_BYTES:-104857600}
  max_files_per_request: ${UPLOAD_MAX_FILES_PER_REQUEST:-20}
  max_documents_per_dataset: ${DATASET_MAX_DOCUMENTS:-10000}
  body_timeout_seconds: ${UPLOAD_BODY_TIMEOUT_SECONDS:-600}
  allowed_extensions: '${UPLOAD_ALLOWED_EXTENSIONS:-}'

# Ingestion worker (D-05, R-165). reclaim_idle_ms must be at least twice lock_ttl_seconds * 1000.
ingest:
  task_page_size: ${TASK_PAGE_SIZE:-12}
  batch_size: ${INGEST_BATCH_SIZE:-64}
  max_attempts: ${INGEST_MAX_ATTEMPTS:-3}
  lock_ttl_seconds: ${TASK_LOCK_TTL_SECONDS:-60}
  reclaim_idle_ms: ${RECLAIM_IDLE_MS:-120000}
  reclaim_interval_seconds: ${RECLAIM_INTERVAL_SECONDS:-15}
  worker_heartbeat_timeout: ${WORKER_HEARTBEAT_TIMEOUT:-120}
  progress_interval_seconds: ${PROGRESS_INTERVAL_SECONDS:-2}
  cancel_poll_seconds: ${CANCEL_POLL_SECONDS:-1}
  retry_backoff_max_seconds: ${INGEST_RETRY_BACKOFF_MAX_SECONDS:-30}
  reconcile_after_seconds: ${RECONCILE_AFTER_SECONDS:-300}
  xlsx_max_cells: ${XLSX_MAX_CELLS:-1000000}
  text_preview_chars: ${TEXT_PREVIEW_CHARS:-262144}
  parse_rate_max: ${PARSE_RATE_MAX:-120}
  parse_rate_window_seconds: ${PARSE_RATE_WINDOW_SECONDS:-60}
  task_concurrency: ${INGEST_TASK_CONCURRENCY:-1}
  chunk_concurrency: ${INGEST_CHUNK_CONCURRENCY:-1}
  embed_concurrency: ${INGEST_EMBED_CONCURRENCY:-2}
  storage_concurrency: ${INGEST_STORAGE_CONCURRENCY:-4}
  kg_concurrency: ${INGEST_KG_CONCURRENCY:-1}
  pdf_render_threads: ${PDF_RENDER_THREADS:-2}
  queue_prefix: '${INGEST_QUEUE_PREFIX:-te}'
  consumer_group: '${INGEST_CONSUMER_GROUP:-ragflow_consumer_group}'

# Retrieval (plan 05-02, R-203). rerank_max_candidates is measured for BGE CPU (R-219).
retrieval:
  top_k: ${RETRIEVAL_TOP_K:-1024}
  rerank_max_candidates: ${RETRIEVAL_RERANK_MAX_CANDIDATES:-16}
  msm_percent: ${RETRIEVAL_MSM_PERCENT:-30}
  msm_retry_percent: ${RETRIEVAL_MSM_RETRY_PERCENT:-10}
  synonym_ttl_seconds: ${RETRIEVAL_SYNONYM_TTL_SECONDS:-86400}
  rate_max: ${RETRIEVAL_RATE_MAX:-30}
  rate_window_seconds: ${RETRIEVAL_RATE_WINDOW_SECONDS:-60}

# Isolated native service. Explicit DEEPDOC_URL takes precedence over its legacy alias.
deepdoc:
  url: '${DEEPDOC_URL:-}'
  legacy_url: '${TENSORRT_DLA_SVR:-}'
  api_token: '${DEEPDOC_API_TOKEN:-}'
  timeout_seconds: 60

# Chat sessions and turns (plan 05-09).
chat:
  stream_deadline_seconds: ${CHAT_STREAM_DEADLINE_SECONDS:-300}
  max_question_chars: ${CHAT_MAX_QUESTION_CHARS:-8000}
  max_session_messages: ${CHAT_MAX_SESSION_MESSAGES:-400}
  rate_max: ${CHAT_RATE_MAX:-30}
  rate_window_seconds: ${CHAT_RATE_WINDOW_SECONDS:-60}
  message_page_size: ${CHAT_MESSAGE_PAGE_SIZE:-50}
