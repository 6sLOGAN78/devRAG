FROM node:20-alpine AS builder

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ .
# Inject production API endpoint via build argument if needed, 
# or Vite can handle relative paths if reverse proxied correctly.
RUN npm run build

FROM nginx:1.25-alpine

# Copy built assets to Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Replace default Nginx config to support React Router SPA fallback
RUN cat <<'EOT' > /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOT

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
