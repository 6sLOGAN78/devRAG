# devRag stack variable catalog (docs/18-deployment/environment-variables.md).
# Run `make init-env` to create docker/.env with generated secrets. Never commit docker/.env.
# Variables marked "# secret" are empty here on purpose; compose fails fast while they are unset.

COMPOSE_PROJECT_NAME=devrag-stack
BIND_HOST=127.0.0.1
TIMEZONE=UTC

# Images
RAGFLOW_IMAGE=devrag-app:local
DEEPDOC_IMAGE=devrag-deepdoc:local
# Optional isolated native parsing. Provision approved models before enabling this profile.
DEEPDOC_URL=
TENSORRT_DLA_SVR=
DEEPDOC_MODEL_DIR=../ragflow-logs/deepdoc-models
DEEPDOC_PORT=9390
# secret
DEEPDOC_API_TOKEN=
MYSQL_IMAGE=mysql:8.0.40
STACK_VERSION=8.11.3
INFINITY_IMAGE=infiniflow/infinity:v0.7.2-x64-v3

# Ports. Host 80 and 6379 are commonly taken, so web is remapped to 8080/8443 and Redis to 6380.
SVR_WEB_HTTP_PORT=8080
SVR_WEB_HTTPS_PORT=8443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_ADMIN_PORT=9383
GO_HTTP_PORT=9384
EXPOSE_MYSQL_PORT=3306
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6380
NATS_PORT=4222
ES_PORT=9200
OS_PORT=9201
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432
CLICKHOUSE_TCP_PORT=9900
CLICKHOUSE_HTTP_PORT=8123
SANDBOX_EXECUTOR_MANAGER_PORT=9385

# MySQL: root is for administration only, the application uses MYSQL_USER (least privilege).
MYSQL_DBNAME=rag_flow
MYSQL_USER=ragflow_app
# secret
MYSQL_ROOT_PASSWORD=
# secret
MYSQL_PASSWORD=

# Valkey / Redis protocol
# secret
REDIS_PASSWORD=

# MinIO
MINIO_USER=rag_flow
# secret
MINIO_PASSWORD=

# Elasticsearch
# secret
ELASTIC_PASSWORD=

# Other engines (not started in Phase 1)
# secret
OPENSEARCH_PASSWORD=
CLICKHOUSE_USER=ragflow
# secret
CLICKHOUSE_PASSWORD=

# Sandbox
SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=3
SANDBOX_MAX_MEMORY=256m
SANDBOX_TIMEOUT=10s

# Per-engine container memory ceiling
MEM_LIMIT=8g

# App container (non-secret). Go and Python run as this UID/GID so bind-mounted logs stay host-readable.
APP_UID=1000
APP_GID=1000
LOG_DIR=/ragflow/logs

# Token signing key (D-09, R-96): at least 32 characters, never a placeholder. `make init-env` generates 64 hex characters.
# Both servers refuse to start without it.
# secret
SECRET_KEY=

# Auth (D-01, D-03). The superuser is created at startup only when both values are set.
REGISTER_ENABLED=1
SUPERUSER_EMAIL=
# secret
SUPERUSER_PASSWORD=
OTP_TTL_SECONDS=600

# Mail for password-reset codes (D-05). Local default is the Mailpit sidecar; production sets a real relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
# none, starttls or tls
SMTP_SECURITY=none
SMTP_USERNAME=
# secret
SMTP_PASSWORD=
SMTP_FROM=no-reply@devrag.local

# Optional default models seeded for new tenants (D-22). Empty means none are seeded.
DEFAULT_CHAT_MODEL=
DEFAULT_EMBEDDING_MODEL=
DEFAULT_RERANK_MODEL=
DEFAULT_MODEL_FACTORY=
DEFAULT_MODEL_BASE_URL=

# Rate limits (D-29). Defaults are the R-94 production numbers; do not raise them in production.
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL=5
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_OTP_EMAIL_INTERVAL_SECONDS=60
RATE_LIMIT_OTP_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_OTP_PER_IP_PER_HOUR=20
RATE_LIMIT_OTP_WINDOW_SECONDS=3600
RATE_LIMIT_PROVIDER_TEST_PER_TENANT=10
RATE_LIMIT_PROVIDER_TEST_WINDOW_SECONDS=300
# DEV_RATE_LIMIT_PER_IP_MAX is read only by docker/docker-compose.dev.yml (per-IP limits for tests and gates; default 100000).
# DEV_RATE_LIMIT_PER_IP_MAX=100000

# Provider keys at rest (SEC-03, D-23). Encrypts stored model-provider API keys with AES-256-GCM.
# `make init-env` generates 32 random bytes as URL-safe base64. Losing this value makes stored provider keys unreadable.
# secret
LLM_KEY_ENCRYPTION_KEY=
# Identifier written into each sealed value; change it only when rotating the key.
LLM_KEY_ID=k1
# Allow provider base URLs on private networks. Production keeps false; docker-compose.dev.yml sets true for the app service
# (override with DEV_LLM_ALLOW_PRIVATE_BASE_URLS) so tests can reach a fake server on the host.
LLM_ALLOW_PRIVATE_BASE_URLS=false
LLM_CHAT_TIMEOUT_SECONDS=60
LLM_EMBEDDING_TIMEOUT_SECONDS=30
LLM_KEY_TEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3

# File storage and upload limits (D-11, D-13). UPLOAD_MAX_FILE_BYTES cannot exceed 104857600 (the Nginx body cap is 101m).
# STORAGE_IMPL is MINIO or LOCAL.
STORAGE_IMPL=MINIO
STORAGE_LOCAL_DIR=/ragflow/data/storage
UPLOAD_MAX_FILE_BYTES=104857600
UPLOAD_MAX_FILES_PER_REQUEST=20
DATASET_MAX_DOCUMENTS=10000
UPLOAD_BODY_TIMEOUT_SECONDS=600
# Comma list of lower-case extensions. Empty means the built-in list (pdf, docx, pptx, xlsx, txt, md, markdown, csv, json, html, htm, epub, jpg, jpeg, png, mp3, wav, eml).
UPLOAD_ALLOWED_EXTENSIONS=

# Ingestion worker tunables (D-05, R-165). None is a secret. RECLAIM_IDLE_MS must be at least 2 * TASK_LOCK_TTL_SECONDS * 1000.
TASK_PAGE_SIZE=12
INGEST_BATCH_SIZE=64
INGEST_MAX_ATTEMPTS=3
TASK_LOCK_TTL_SECONDS=60
RECLAIM_IDLE_MS=120000
RECLAIM_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TIMEOUT=120
PROGRESS_INTERVAL_SECONDS=2
CANCEL_POLL_SECONDS=1
INGEST_RETRY_BACKOFF_MAX_SECONDS=30
RECONCILE_AFTER_SECONDS=300
XLSX_MAX_CELLS=1000000
TEXT_PREVIEW_CHARS=262144
PARSE_RATE_MAX=120
PARSE_RATE_WINDOW_SECONDS=60
INGEST_TASK_CONCURRENCY=1
INGEST_CHUNK_CONCURRENCY=1
INGEST_EMBED_CONCURRENCY=2
INGEST_STORAGE_CONCURRENCY=4
INGEST_KG_CONCURRENCY=1
PDF_RENDER_THREADS=2
INGEST_QUEUE_PREFIX=te
INGEST_CONSUMER_GROUP=ragflow_consumer_group

# Retrieval tunables (plan 05-02, R-203). None is a secret. RETRIEVAL_RERANK_MAX_CANDIDATES is measured for BGE CPU (R-219).
RETRIEVAL_TOP_K=1024
RETRIEVAL_RERANK_MAX_CANDIDATES=16
RETRIEVAL_MSM_PERCENT=30
RETRIEVAL_MSM_RETRY_PERCENT=10
RETRIEVAL_SYNONYM_TTL_SECONDS=86400
RETRIEVAL_RATE_MAX=30
RETRIEVAL_RATE_WINDOW_SECONDS=60

# Chat sessions and turns (plan 05-09).
CHAT_STREAM_DEADLINE_SECONDS=300
CHAT_MAX_QUESTION_CHARS=8000
CHAT_MAX_SESSION_MESSAGES=400
CHAT_RATE_MAX=30
CHAT_RATE_WINDOW_SECONDS=60
CHAT_MESSAGE_PAGE_SIZE=50

# Live model tests only (D-25). Operator-supplied; never generated, never passed to a container, never committed.
# secret
OPENROUTER_API_KEY=
LIVE_CHAT_MODEL=openai/gpt-4o-mini
LIVE_EMBED_MODEL=baai/bge-m3
LIVE_EXPECTED_DIM=1024

# Local reranker (plan 05-15, R-218); optional token for Hugging Face model downloads.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4
TEI_RERANK_MODEL=BAAI/bge-reranker-base
# Set both model and revision when overriding the audited model.
TEI_RERANK_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
TEI_PORT=6381
# Dev only: optional CPU list matched to this host topology (empty uses all eligible CPUs).
TEI_CPUSET=
# secret
HF_TOKEN=
